#!/usr/bin/env python3
"""パスワードリスト(1行1パスワード)をJSON配列に変換する。

Broken brute-force protection, multiple credentials per request のように
password欄に配列を詰めて送るラボ用のヘルパー。

使い方:
  pbpaste | passwords-to-json                  # 配列だけ出力
  passwords-to-json passwords.txt              # ファイルから
  passwords-to-json -u carlos passwords.txt    # ログインbody全体を出力
"""
import argparse
import json
import sys


def main() -> None:
    parser = argparse.ArgumentParser(
        description="パスワードリストをJSON配列に変換する")
    parser.add_argument(
        "file", nargs="?", type=argparse.FileType("r"), default=sys.stdin,
        help="パスワードリスト(省略時は標準入力)")
    parser.add_argument(
        "-u", "--username",
        help="指定するとログインbody全体 {username, password:[...]} を出力")
    parser.add_argument(
        "-c", "--compact", action="store_true",
        help="改行なしの1行JSONで出力")
    args = parser.parse_args()

    passwords = [line.strip() for line in args.file if line.strip()]

    if args.username:
        payload = {"username": args.username, "password": passwords}
    else:
        payload = passwords

    if args.compact:
        print(json.dumps(payload, ensure_ascii=False))
    else:
        print(json.dumps(payload, ensure_ascii=False, indent=4))


if __name__ == "__main__":
    main()
